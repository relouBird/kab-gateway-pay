# Copy this file to the repository-root .env. Keep real credentials only there.
GLOBAL__NODE_ENV=development
GLOBAL__LOG_LEVEL=info
GLOBAL__AUTH_ISSUER=http://localhost:3000
GLOBAL__AUTH_AUDIENCE=kgpay-services

# PostgreSQL must be running and the kgpay_auth database must already exist.
DATABASE_URL__AUTH_SERVICE=
PORT__AUTH_SERVICE=3000
AUTH_COOKIE_SECURE__AUTH_SERVICE=true
AUTH_COOKIE_SAME_SITE__AUTH_SERVICE=lax
AUTH_CORS_ORIGINS__AUTH_SERVICE=
# Optional: adds a button to STAFF invitation emails. Empty means token-only email.
STAFF_PORTAL_URL__AUTH_SERVICE=

# SMTP points to either a locally installed Maildev or the Docker-published port.
SMTP_HOST__AUTH_SERVICE=127.0.0.1
SMTP_PORT__AUTH_SERVICE=1025
SMTP_FROM__AUTH_SERVICE=no-reply@kgpay.local
SMTP_SECURE__AUTH_SERVICE=false
SMTP_REQUIRE_TLS__AUTH_SERVICE=false
SMTP_USER__AUTH_SERVICE=
SMTP_PASSWORD__AUTH_SERVICE=

# Replace the runtime key placeholders after running auth:keygen.
JWT_PRIVATE_KEY_FILE__AUTH_SERVICE=.local-secrets/auth-private.pem
JWT_KEY_ID__AUTH_SERVICE=
OTP_HASH_KEY__AUTH_SERVICE=
IP_HASH_KEY__AUTH_SERVICE=
AUTH_SERVICE_CLIENTS_JSON__AUTH_SERVICE=
AUTH_SIGNING_PUBLIC_KEYS_JSON__AUTH_SERVICE=

# CDC-01 §8.5 defaults: configurable proposals, not validated security decisions.
OTP_LENGTH__AUTH_SERVICE=6
OTP_TTL_SECONDS__AUTH_SERVICE=300
OTP_MAX_ATTEMPTS__AUTH_SERVICE=5
OTP_RESEND_COOLDOWN_SECONDS__AUTH_SERVICE=60
OTP_MAX_SENDS_PER_HOUR__AUTH_SERVICE=5
AUTH_ACCESS_TTL_SECONDS__AUTH_SERVICE=600
CUSTOMER_REFRESH_TTL_DAYS__AUTH_SERVICE=30
STAFF_REFRESH_TTL_SECONDS__AUTH_SERVICE=28800
STAFF_IDLE_TTL_SECONDS__AUTH_SERVICE=1800
CUSTOMER_SESSION_LIMIT__AUTH_SERVICE=5
STAFF_SESSION_LIMIT__AUTH_SERVICE=3
LOGIN_FAILURES_BEFORE_LOCK__AUTH_SERVICE=5
LOGIN_LOCK_BASE_SECONDS__AUTH_SERVICE=900
LOGIN_LOCK_MAX_SECONDS__AUTH_SERVICE=86400
PASSWORD_MIN_LENGTH__AUTH_SERVICE=10
INVITATION_TTL_SECONDS__AUTH_SERVICE=172800
STEP_UP_TTL_SECONDS__AUTH_SERVICE=300
STAFF_INACTIVITY_DAYS__AUTH_SERVICE=90
LOGIN_IP_MAX_ATTEMPTS__AUTH_SERVICE=10
LOGIN_IP_WINDOW_SECONDS__AUTH_SERVICE=60

# customer-portal (variables publiques VITE_*, jamais de secret). L'origine du portail doit figurer dans AUTH_CORS_ORIGINS__AUTH_SERVICE.
VITE_AUTH_API_URL__CUSTOMER_PORTAL=http://localhost:3000
VITE_PASSWORD_MIN_LENGTH__CUSTOMER_PORTAL=10
VITE_OTP_RESEND_COOLDOWN_SECONDS__CUSTOMER_PORTAL=60

# staff-portal (mêmes variables publiques ; ajouter http://localhost:5174 aux origines CORS).
VITE_AUTH_API_URL__STAFF_PORTAL=http://localhost:3000
VITE_PASSWORD_MIN_LENGTH__STAFF_PORTAL=10
VITE_OTP_RESEND_COOLDOWN_SECONDS__STAFF_PORTAL=60
