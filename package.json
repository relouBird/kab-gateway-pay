{
  "name": "kgpay",
  "version": "1.0.6",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "prepare": "husky",
    "env:build": "node scripts/generate-env.cjs --mode build",
    "env:runtime": "node scripts/generate-env.cjs --mode runtime",
    "build": "turbo run build",
    "build:auth-service": "turbo run build --filter=auth-service",
    "build:customer-portal": "turbo run build --filter=customer-portal",
    "build:staff-portal": "turbo run build --filter=staff-portal",
    "dev": "turbo run dev",
    "dev:customer-portal": "pnpm --filter customer-portal dev",
    "dev:staff-portal": "pnpm --filter staff-portal dev",
    "start:auth-service": "pnpm --filter auth-service start:dev",
    "start:auth-service:debug": "pnpm --filter auth-service start:debug",
    "start:auth-service:prod": "pnpm --filter auth-service start:prod",
    "auth:bootstrap": "pnpm --filter auth-service auth:bootstrap",
    "db:auth-service:generate": "pnpm --filter auth-service exec prisma generate",
    "db:auth-service:migrate:dev": "node scripts/run-prisma.cjs migrate dev",
    "db:auth-service:migrate:deploy": "node scripts/run-prisma.cjs migrate deploy",
    "format:auth-service": "pnpm --filter auth-service format",
    "lint": "turbo run lint",
    "lint:auth-service": "turbo run lint --filter=auth-service",
    "lint:customer-portal": "turbo run lint --filter=customer-portal",
    "lint:staff-portal": "turbo run lint --filter=staff-portal",
    "typecheck": "turbo run typecheck",
    "typecheck:auth-service": "turbo run typecheck --filter=auth-service",
    "typecheck:customer-portal": "turbo run typecheck --filter=customer-portal",
    "typecheck:staff-portal": "turbo run typecheck --filter=staff-portal",
    "test": "node --test scripts/generate-env.test.cjs scripts/run-prisma.test.cjs scripts/bump-version.test.cjs && turbo run test",
    "test:auth-service": "pnpm --filter auth-service test",
    "test:customer-portal": "pnpm --filter customer-portal test",
    "test:staff-portal": "pnpm --filter staff-portal test",
    "test:auth-service:watch": "pnpm --filter auth-service test:watch",
    "test:auth-service:coverage": "pnpm --filter auth-service test:cov",
    "test:auth-service:debug": "pnpm --filter auth-service test:debug",
    "test:e2e:auth-service": "pnpm --filter auth-service test:e2e",
    "test:e2e:auth-service:isolated": "node scripts/run-auth-service-e2e.cjs",
    "test:e2e:auth-service:maildev": "node scripts/run-auth-service-e2e.cjs --maildev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "prisma"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  }
}
