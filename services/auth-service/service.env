# SMTP local (Maildev). Aucun identifiant SMTP n'est stocké ici.
PORT=3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@kgpay.local
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
# Vide : CORS reste désactivé jusqu'à la configuration de l'hébergement.
AUTH_CORS_ORIGINS=

# Paramètres numériques configurables ; valeurs par défaut proposées par CDC-01 §8.5.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
AUTH_ACCESS_TTL_SECONDS=600
CUSTOMER_REFRESH_TTL_DAYS=30
STAFF_REFRESH_TTL_SECONDS=28800
STAFF_IDLE_TTL_SECONDS=1800
CUSTOMER_SESSION_LIMIT=5
STAFF_SESSION_LIMIT=3
LOGIN_FAILURES_BEFORE_LOCK=5
LOGIN_LOCK_BASE_SECONDS=900
LOGIN_LOCK_MAX_SECONDS=86400
PASSWORD_MIN_LENGTH=10
INVITATION_TTL_SECONDS=172800
STEP_UP_TTL_SECONDS=300
STAFF_INACTIVITY_DAYS=90
LOGIN_IP_MAX_ATTEMPTS=10
LOGIN_IP_WINDOW_SECONDS=60
