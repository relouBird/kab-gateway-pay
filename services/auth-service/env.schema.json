{
  "properties": {
    "NODE_ENV": {
      "type": "enum",
      "values": ["development", "test", "production"]
    },
    "LOG_LEVEL": {
      "type": "enum",
      "values": ["debug", "info", "warn", "error"]
    },
    "AUTH_ISSUER": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@+-]+$"
    },
    "AUTH_AUDIENCE": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@,+-]+$"
    },
    "AUTH_COOKIE_SECURE": {
      "type": "boolean"
    },
    "AUTH_COOKIE_SAME_SITE": {
      "type": "enum",
      "values": ["strict", "lax", "none"]
    },
    "AUTH_CORS_ORIGINS": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/@,+-]*$",
      "allowEmpty": true
    },
    "STAFF_PORTAL_URL": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$",
      "allowEmpty": true
    },
    "PORT": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "SMTP_HOST": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+$"
    },
    "SMTP_PORT": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "SMTP_FROM": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$"
    },
    "SMTP_SECURE": {
      "type": "boolean"
    },
    "SMTP_REQUIRE_TLS": {
      "type": "boolean"
    },
    "OTP_LENGTH": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "OTP_TTL_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "OTP_MAX_ATTEMPTS": {
      "type": "integer",
      "minimum": 1
    },
    "OTP_RESEND_COOLDOWN_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "OTP_MAX_SENDS_PER_HOUR": {
      "type": "integer",
      "minimum": 1
    },
    "AUTH_ACCESS_TTL_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "CUSTOMER_REFRESH_TTL_DAYS": {
      "type": "integer",
      "minimum": 1
    },
    "STAFF_REFRESH_TTL_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "STAFF_IDLE_TTL_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "CUSTOMER_SESSION_LIMIT": {
      "type": "integer",
      "minimum": 1
    },
    "STAFF_SESSION_LIMIT": {
      "type": "integer",
      "minimum": 1
    },
    "LOGIN_FAILURES_BEFORE_LOCK": {
      "type": "integer",
      "minimum": 1
    },
    "LOGIN_LOCK_BASE_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "LOGIN_LOCK_MAX_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "PASSWORD_MIN_LENGTH": {
      "type": "integer",
      "minimum": 1
    },
    "INVITATION_TTL_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "STEP_UP_TTL_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "STAFF_INACTIVITY_DAYS": {
      "type": "integer",
      "minimum": 1
    },
    "LOGIN_IP_MAX_ATTEMPTS": {
      "type": "integer",
      "minimum": 1
    },
    "LOGIN_IP_WINDOW_SECONDS": {
      "type": "integer",
      "minimum": 1
    },
    "DATABASE_URL": {
      "type": "string",
      "pattern": "^postgres(ql)?:\\/\\/.+"
    },
    "JWT_SIGNING_SECRET": {
      "type": "string",
      "minLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "JWT_SIGNING_PREVIOUS_SECRETS_JSON": {
      "type": "string",
      "allowEmpty": true
    },
    "OTP_HASH_KEY": {
      "type": "string",
      "minLength": 32
    },
    "IP_HASH_KEY": {
      "type": "string",
      "allowEmpty": true
    },
    "SMTP_USER": {
      "type": "string",
      "allowEmpty": true
    },
    "SMTP_PASSWORD": {
      "type": "string",
      "allowEmpty": true
    },
    "AUTH_SERVICE_CLIENTS_JSON": {
      "type": "string",
      "allowEmpty": true
    }
  },
  "requiredKeys": [
    "NODE_ENV",
    "LOG_LEVEL",
    "AUTH_ISSUER",
    "AUTH_AUDIENCE",
    "AUTH_COOKIE_SECURE",
    "AUTH_COOKIE_SAME_SITE",
    "AUTH_CORS_ORIGINS",
    "PORT",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_FROM",
    "SMTP_SECURE",
    "SMTP_REQUIRE_TLS",
    "OTP_LENGTH",
    "OTP_TTL_SECONDS",
    "OTP_MAX_ATTEMPTS",
    "OTP_RESEND_COOLDOWN_SECONDS",
    "OTP_MAX_SENDS_PER_HOUR",
    "AUTH_ACCESS_TTL_SECONDS",
    "CUSTOMER_REFRESH_TTL_DAYS",
    "STAFF_REFRESH_TTL_SECONDS",
    "STAFF_IDLE_TTL_SECONDS",
    "CUSTOMER_SESSION_LIMIT",
    "STAFF_SESSION_LIMIT",
    "LOGIN_FAILURES_BEFORE_LOCK",
    "LOGIN_LOCK_BASE_SECONDS",
    "LOGIN_LOCK_MAX_SECONDS",
    "PASSWORD_MIN_LENGTH",
    "INVITATION_TTL_SECONDS",
    "STEP_UP_TTL_SECONDS",
    "STAFF_INACTIVITY_DAYS",
    "LOGIN_IP_MAX_ATTEMPTS",
    "LOGIN_IP_WINDOW_SECONDS",
    "DATABASE_URL",
    "JWT_SIGNING_SECRET",
    "OTP_HASH_KEY"
  ],
  "sharedKeys": ["NODE_ENV", "LOG_LEVEL", "AUTH_ISSUER", "AUTH_AUDIENCE"],
  "targetPrefix": "AUTH_SERVICE",
  "forbiddenKeys": ["JWT_PRIVATE_KEY", "JWT_KEY_ID"],
  "forbiddenKeyPatterns": []
}
