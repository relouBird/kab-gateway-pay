{
  "name": "auth-service",
  "version": "0.1.0",
  "description": "Identité et contrôle des accès KG Pay",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node ../../scripts/generate-env.cjs --target auth-service --mode build",
    "build": "pnpm --filter @kgpay/contracts build && prisma generate && node ../../scripts/run-with-env.cjs --target auth-service --mode build -- nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prestart": "node ../../scripts/generate-env.cjs --target auth-service --mode runtime",
    "start": "pnpm --filter @kgpay/contracts build && prisma generate && nest start",
    "prestart:dev": "node ../../scripts/generate-env.cjs --target auth-service --mode runtime",
    "start:dev": "pnpm --filter @kgpay/contracts build && prisma generate && nest start --watch",
    "dev": "pnpm run start:dev",
    "prestart:debug": "node ../../scripts/generate-env.cjs --target auth-service --mode runtime",
    "start:debug": "pnpm --filter @kgpay/contracts build && prisma generate && nest start --debug --watch",
    "prestart:prod": "node ../../scripts/generate-env.cjs --target auth-service --mode runtime",
    "start:prod": "node dist/main.js",
    "preauth:bootstrap": "node ../../scripts/generate-env.cjs --target auth-service --mode runtime",
    "auth:bootstrap": "pnpm --filter @kgpay/contracts build && ts-node src/cli/bootstrap-super-admin.ts",
    "lint": "pnpm --filter @kgpay/contracts build && oxlint --type-aware src/ test/",
    "typecheck": "pnpm --filter @kgpay/contracts build && prisma generate && tsc --noEmit",
    "test": "pnpm --filter @kgpay/contracts build && prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "pnpm --filter @kgpay/contracts build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "pnpm --filter @kgpay/contracts build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "pnpm --filter @kgpay/contracts build && node --inspect-brk --experimental-vm-modules -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm --filter @kgpay/contracts build && prisma generate && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@kgpay/contracts": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  }
}
