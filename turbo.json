{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["//#env:build", "^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build", "^test"]
    },
    "dev": {
      "dependsOn": ["//#env:runtime"],
      "cache": false,
      "persistent": true
    },
    "//#env:build": {
      "cache": false
    },
    "//#env:runtime": {
      "cache": false
    }
  }
}
